{
  "name": "obsidian-flashcard-importer",
  "version": "0.2.6",
  "private": true,
  "description": "Import Markdown notes, outlines, and text-based flashcards into RemNote. Manually re-import changes to tracked notes. Independent beta; no live vault sync or attachment import.",
  "license": "MIT",
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "dev": "cross-env NODE_ENV=development webpack serve --color --progress --no-open",
    "build": "npm run check-types && npm run test && npm run lint && npx remnote-plugin validate && shx rm -rf dist && cross-env NODE_ENV=production webpack --color --progress && node scripts/package-plugin.cjs"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "0.0.46",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@types/node": "^22.10.2",
    "@types/react": "^17.0.83",
    "@types/react-dom": "^17.0.26",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "bestzip": "^2.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "glob": "^10.4.5",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "react-refresh": "^0.14.2",
    "shx": "^0.3.4",
    "style-loader": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
